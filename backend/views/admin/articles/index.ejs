<script src="https://unpkg.com/tabulator-tables@6.5.0/dist/js/tabulator.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" ></script>

  <script>

    // const tableData =<%//-JSON.strinigy(users)%>;
    const tableData =JSON.parse(document.getElementById("articles").textContent);//so now this convert userdata string to json
    
    // console.log(tableData);

      var table = new Tabulator("#articleTable", {
       // height:205,  set height of table (in CSS or here), this enables the Virtual DOM and improves render speed dramatically (can be any valid css height value)
        data:tableData, //assign data to table
        layout:"fitColumns", //fit columns to width of table (optional)
        pagination:true,
        paginationSize:10,
        paginationSizeSelector:[10, 25, 50, 100],
        columns:[
            {title:"S/N", formatter:"rownum",width:70,hozAlign:"center"},
            {title:"Title", field:"title", headerFilter:"input"},
            {title:"Category Name", field:"category.name", headerFilter:"input"},
            {title:"Author", field:"author.fullname", headerFilter:"input",},
            {title:"Date", field:"createdAt", headerFilter:"input",
            formatter:function(cell,formatterParams,onRendered){
                var date = new Date(cell.getValue());
                return date.toDateString().replaceAll(" ","-");
            }},
           
            {
              title:"Action",formatter:function(cell, formatterParams, onRendered){ //search custom formatter
                return `<a href="/admin/updateArticle/${cell.getData()._id}" class="btn btn-sm btn-success">Edit</a>
                        <a class="btn btn-sm btn-danger" onclick="deleteArticle('${cell.getData()._id}')">delete</a>`
            }
            }

        ]
      });

      async function deleteArticle(id){
        try {
          if(confirm("are you sure to delete this Article")){
            const response = await fetch(`/admin/deleteArticle/${id}`,{method:'delete'})
            if(response.ok){
            window.location.reload();
          }
          }
        } catch (error) {
          
        }
      }




  </script>

